# 이 파일을 복사해서 backend/.env 를 만들고, 값을 직접 채워 주세요.
# .env 는 깃에 올라가지 않습니다. 비밀번호나 키를 채팅·문서에 적지 마세요.

# ─────────────────────────────────────────────────────────────
# 1. SL 사용 비밀번호 (처음 한 번만 쓰입니다)
# ─────────────────────────────────────────────────────────────
# 8글자 이상. 데이터 보관함이 비어 있는 처음 켤 때 암호화되어 저장되고,
# 이후에는 설정 화면(또는 set_password.py)에서 바꿉니다.
INITIAL_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 2. Supabase(PostgreSQL) 연결 정보 — Session pooler 값을 씁니다
# ─────────────────────────────────────────────────────────────
# 어디서 찾나요?
#   Supabase 대시보드 → 프로젝트 선택 → 위쪽의 [Connect] 버튼
#   → 'Session pooler' 항목을 고르면 아래 값들이 나옵니다.
#   (Direct connection 이나 Transaction pooler 값이 아닙니다)
#
# 값만 적어 주세요. 따옴표나 postgresql:// 는 넣지 않습니다.
# 비밀번호에 특수문자(@ : / # 등)가 있어도 그대로 적으면 됩니다.

# 접속 주소. 예: aws-0-ap-northeast-2.pooler.supabase.com  (프로젝트마다 다릅니다)
DB_HOST=

# Session pooler 는 보통 5432 입니다.
DB_PORT=5432

# 데이터베이스 이름. 보통 postgres 입니다.
DB_NAME=postgres

# 사용자 이름. 'postgres.프로젝트ID' 형태입니다. (그냥 postgres 가 아닙니다)
DB_USER=

# 프로젝트를 만들 때 정한 '데이터베이스 비밀번호'.
# (SL 사용 비밀번호와 다르고, Supabase 계정 비밀번호와도 다릅니다)
DB_PASSWORD=

# 보안 연결 방식. Supabase 는 require 를 씁니다. 바꾸지 않아도 됩니다.
DB_SSLMODE=require

# ─────────────────────────────────────────────────────────────
# 3. 화면(React)이 열리는 주소. 쉼표로 여러 개를 적을 수 있습니다.
# ─────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173

# ※ DATABASE_URL 항목은 더 이상 쓰이지 않습니다. 예전 .env 에 남아 있다면 지워도 됩니다.

# ─────────────────────────────────────────────────────────────
# 4. AI 점검 (OpenAI) — 키 한 줄만 넣으면 켜집니다
# ─────────────────────────────────────────────────────────────
# 키는 platform.openai.com 에서 발급합니다. 채팅·문서에 적지 마세요.
# 키를 넣으면 서버를 다시 켜지 않아도 반영됩니다. 확인: .\.venv\Scripts\python.exe check_ai.py
OPENAI_API_KEY=

# 아래는 바꾸지 않아도 됩니다. (비워 두거나 지워도 기본값으로 동작합니다)
# AI 기능을 끄고 싶을 때만 false (키가 있어도 꺼집니다)
AI_ENABLED=true
# 모델 이름. 비워 두면 이 키로 쓸 수 있는 모델을 자동으로 고릅니다.
OPENAI_MODEL=
# 이번 달 AI 호출 상한(재시도 포함). 넘으면 AI를 멈추고 고정 문구로 보여줍니다.
AI_MONTHLY_CALL_LIMIT=300
# 한 번의 호출 제한 시간(초)과 재시도 횟수
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1

# ─────────────────────────────────────────────────────────────
# 5. 공식 일정 가져오기 (공휴일, 근처 학교 방학) — 아직 만드는 중이라 비워 두어도 됩니다
# ─────────────────────────────────────────────────────────────
# 모두 무료 발급입니다. 키는 채팅·문서에 적지 마세요.
# 공공데이터포털(data.go.kr) 인증키: '한국천문연구원 특일 정보'와 '전국초중등학교위치표준데이터' 활용 신청 후 받는 키
DATA_GO_KR_API_KEY=
# NEIS 교육정보 개방 포털(open.neis.go.kr) 인증키: 학사일정 조회용
NEIS_API_KEY=
# 공공데이터포털(data.go.kr) '한국천문연구원 특일 정보' 인증키: 올해·내년 공휴일(대체공휴일 포함)을 가져올 때 씁니다. 서비스마다 활용 신청이 따로입니다.
HOLIDAY_API_KEY=
# 카카오 개발자(developers.kakao.com) REST API 키: 점포 주소를 검색해 위치를 찾을 때 씁니다.
# 내 애플리케이션 → 앱 설정 → 일반에서 '카카오맵' 사용을 켜야 합니다.
KAKAO_REST_API_KEY=
# 공공데이터포털(data.go.kr) '전국전통시장표준데이터' 인증키: 근처 장날(5일장)을 찾을 때 씁니다. 활용 신청은 서비스마다 따로 해야 해서
# DATA_GO_KR_API_KEY 와 다른 키가 나올 수 있습니다.
MARKET_API_KEY=
# 기상청 날씨 (공공데이터포털, 서비스마다 활용 신청과 키가 따로입니다). 내일 예상 매출에 씁니다 (docs/forecast-considerations.md). 기상특보 키는 아직 앱에서 쓰지 않습니다.
# 지상(종관, ASOS) 일자료: 과거 날씨
WEATHER_PAST_API_KEY=
# 단기예보(동네예보): 내일 예보
WEATHER_FORECAST_API_KEY=
# 기상특보 조회서비스: 최근 6일의 특보만 조회됩니다
WEATHER_WARNING_API_KEY=
# (키가 없거나 주소가 안 찾아지면 설정 화면에서 위도·경도를 직접 입력할 수도 있습니다)

# 주변 상가 정보(소상공인시장진흥공단 상가정보, 공공데이터포털 활용신청). AI 제안에서 경쟁 편의점 수와 업종 분포에 씁니다.
STORE_API_KEY=

# 동네 인구(통계청 SGIS 오픈API). 서비스 ID와 보안 Key 두 개가 필요합니다.
SGIS_ID=
SGIS_SECURITY_KEY=
