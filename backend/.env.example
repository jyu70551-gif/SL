# 이 파일을 복사해서 backend/.env 를 만들고, 값을 직접 채워 주세요.
# .env 는 깃에 올라가지 않습니다. 비밀번호나 키를 채팅·문서에 적지 마세요.

# 처음 한 번만 쓰이는 비밀번호입니다 (8글자 이상).
# 서버가 처음 켜질 때 암호화되어 저장되고, 이후에는 설정 화면에서 바꿉니다.
INITIAL_PASSWORD= 

# 데이터 보관 위치. 개발 중에는 SQLite(내 컴퓨터의 파일 하나)를 씁니다.
DATABASE_URL=sqlite:///./sl_dev.db
# 나중에 Supabase를 쓸 때는 이 줄의 형태로 바꿉니다 (Phase 2에서 연결):
# DATABASE_URL=postgresql+psycopg://...

# 화면(React)이 열리는 주소. 쉼표로 여러 개를 적을 수 있습니다.
FRONTEND_ORIGINS=http://localhost:5173
